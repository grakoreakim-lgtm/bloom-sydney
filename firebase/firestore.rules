rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read: today's product listing
    match /daily_products/{date} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Customer-facing product catalogue: anyone can read, only signed-in users (= admin) write.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Store settings (delivery fees, cutoff time, etc.): public read so customer page can use,
    // only signed-in admin can edit.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: customer site may CREATE (for future Stripe checkout). Read/update/delete admin-only.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Customers: admin-only (auto-created by admin when an order is saved).
    match /customers/{email} {
      allow read, write: if request.auth != null;
    }

    // FAQs: public read, auth-only write.
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reviews: public read, auth-only write.
    // (Phase B: customer-side review submission will need a separate /pending_reviews flow.)
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Add-ons (chocolate, card, gift wrap, etc.): public read, auth-only write.
    match /addons/{addonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Daily prep journal — one document per day (doc id = YYYY-MM-DD).
    // Public read for SEO, admin-only write.
    match /daily_prep/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Custom order requests: public CREATE (so customer site form works),
    // admin-only read/update/delete.
    match /customOrders/{reqId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Blog posts: public read (SEO), admin-only write.
    match /blog/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public read: Instagram feed cache
    match /cache/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }

    // Admin push-notification devices: each doc id is an FCM token.
    // Any signed-in admin can register/refresh their own token, and read the list.
    // Cloud Functions read this list with the admin SDK, bypassing rules.
    match /admin_devices/{token} {
      allow read, write: if request.auth != null;
    }

    // Mail queue (read by Firebase Trigger Email extension).
    // Only Cloud Functions write here (via admin SDK, bypassing rules).
    // Browsers must NEVER write directly — that would let anyone send email from our domain.
    match /mail/{mailId} {
      allow read, write: if false;
    }
    match /mail_templates/{tmplId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Customer anniversaries (sub-collection of customers)
    match /customers/{email}/anniversaries/{annivId} {
      allow read, write: if request.auth != null;
    }

    // ─── B2B (lobby / reception flower subscriptions) — see docs/B2B_PLAN.md ───

    // Leads: the /business/ form may CREATE a new website enquiry only. Admin does the rest.
    match /b2bLeads/{leadId} {
      allow create: if request.auth != null || (
        request.resource.data.status == 'NEW' &&
        request.resource.data.source == 'website' &&
        request.resource.data.company is string && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 200 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.keys().hasOnly(['company','industry','abn','contactName','role','email','phone',
                                              'address','tier','frequency','notes','source','status','createdAt'])
      );
      allow read, update, delete: if request.auth != null;
    }

    // Proposals: doc id is an unguessable token sent to the client by email.
    //  - anyone with the link may GET it (never LIST)
    //  - the client may approve/decline once (status SENT → APPROVED | DECLINED, writing only `approval`)
    //  - after approval the client may post a self-service request (continue / pause / resume / cancel)
    // Cloud Functions react to these updates (onB2BProposalUpdate).
    match /b2bProposals/{token} {
      allow get: if true;
      allow list, create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (resource.data.status == 'SENT'
            && request.resource.data.status in ['APPROVED', 'DECLINED']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approval'])
            && (request.resource.data.status == 'DECLINED'
                || request.resource.data.approval.paymentMethod in ['CARD', 'INVOICE', 'TERMINAL']))
        || (resource.data.status == 'APPROVED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerRequest'])
            && request.resource.data.customerRequest.action in ['CONTINUE', 'PAUSE', 'RESUME', 'CANCEL']);
    }

    // Accounts + visits: admin only (Cloud Functions use the admin SDK).
    match /b2bAccounts/{accountId} {
      allow read, write: if request.auth != null;
      match /visits/{visitId} {
        allow read, write: if request.auth != null;
      }
    }

    // Subscriptions: signed-in users (= admin) only
    match /subscriptions/{subId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }
  }
}
